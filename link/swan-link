#!/bin/sh
# What Mednafen runs (wswan.excomm.path). Finds Node even when Mednafen was started from the Dock,
# where Homebrew's PATH isn't set.
DIR=$(cd "$(dirname "$0")" && pwd)
for n in "$(command -v node 2>/dev/null)" /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
  if [ -n "$n" ] && [ -x "$n" ]; then exec "$n" "$DIR/swan-link.mjs" "$@"; fi
done
echo "Swan Revival Link needs Node.js 22 or newer: https://nodejs.org/" >&2
exit 1
